{%- comment -%}
  QUADRANT (400x240) — Minimal postcard layout
  ════════════════════════════════════════════════════════════════
  Tiny space. Highly focused "Up Next" cards with item meta emphasis
  for priority, empty meta, truncated title.

  COMPACT CARD PATTERN:
  - Item with meta emphasis class based on priority (empty meta)
  - Task name (truncated, strikethrough if done)
  - Due date (relative: "Today", "Tomorrow", "overdue by X")
  - No numbering
{%- endcomment -%}

{%- assign view_name = "quadrant" -%}
{%- assign device_height = trmnl.device.height | default: 240 | plus: 0 -%}
{%- assign device_width = trmnl.device.width | default: 400 | plus: 0 -%}
{%- if device_height > device_width -%}
  {%- assign is_portrait = true -%}
{%- else -%}
  {%- assign is_portrait = false -%}
{%- endif -%}

{% if view_mode == "kanban" %}
  {% if kanban_error != "" %}
    <div class="layout layout--col flex--top gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">Kanban unavailable</span>
          <span class="description">{{ kanban_error }}</span>
        </div>
      </div>
    </div>
  {% elsif data.buckets and data.buckets.size > 0 %}
    <div class="layout layout--col layout--top gap">
      <div class="flex flex--col flex--left w--full gap">
        {% for column in data.buckets %}
          <div class="flex flex--col flex--left w--full px--small">
            <span class="title title--small text--left {% unless is_portrait %}hidden{% endunless %}">{{ column.title | upcase }} ({{ column.tasks.size }})</span>
            <div class="flex flex--col gap--small mt--small">
              {% for task in column.tasks %}
                {%- comment -%} PRIORITY: emphasis 4=urgent, 3=high, 2=medium {%- endcomment -%}
                {%- if task.priority == 4 -%}
                  {%- assign emphasis_class = "item--emphasis-3" -%}
                {%- elsif task.priority == 3 -%}
                  {%- assign emphasis_class = "item--emphasis-2" -%}
                {%- elsif task.priority == 2 -%}
                  {%- assign emphasis_class = "item--emphasis-1" -%}
                {%- else -%}
                  {%- assign emphasis_class = "" -%}
                {%- endif -%}
                <div class="item {{ emphasis_class }}">
                  <div class="meta"></div>
                  <div class="content">
                    {% if column.done or task.done %}
                      <div class="title text--small text--gray-50 1bit:text--black 1bit:text--regular text--wrap" style="text-decoration: line-through;">{{ task.title }}</div>
                    {% else %}
                      <div class="title text--small text--wrap">{{ task.title }}</div>
                    {% endif %}
                    {%- assign show_meta = false -%}
                    {% if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil %}{%- assign show_meta = true -%}{% endif %}
                    {% if task.assignees.size > 0 %}{%- assign show_meta = true -%}{% endif %}
                    {%- assign pnum = task.priority | default: 0 | plus: 0 -%}
                    {% if pnum > 0 %}{%- assign show_meta = true -%}{% endif %}
                    {% if column.done == false and show_meta %}
                      <div class="flex gap--small {% unless is_portrait %}hidden{% endunless %}">
                        {% if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil %}
                          <span class="label label--gray text--small 1bit:text--black 1bit:text--regular">{{ icon_calendar }} {{ task.due_date | l_date: "%d %b", trmnl.user.locale }}</span>
                        {% endif %}
                        {% if task.assignees.size > 0 %}
                          <span class="label label--gray text--small 1bit:text--black 1bit:text--regular">{{ icon_person }} {{ task.assignees[0].name }}</span>
                        {% endif %}
                        {% if pnum > 0 %}
                          <span class="label label--gray text--small 1bit:text--black 1bit:text--regular">{{ icon_flag }} {{ task.priority }}</span>
                        {% endif %}
                      </div>
                      {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          {% unless forloop.last %}<div class="divider--h"></div>{% endunless %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="meta"></div>
      <div class="content"><span class="title">No Kanban tasks</span></div>
    </div>
  {% endif %}
{% else %}
  {%- assign filtered_tasks = data -%}
  {%- assign tpv = tasks_per_view | plus: 0 -%}
  {%- if tpv < 1 -%}{%- assign tpv = 3 -%}{%- endif -%}
  {%- assign filtered_tasks = filtered_tasks | slice: 0, tpv -%}

  <div class="layout layout--col layout--top gap">
    {% if filtered_tasks.size > 0 %}
      <div class="columns" data-overflow-max-cols="1">
        <div class="column">
          {% for task in filtered_tasks %}
            {%- comment -%} PRIORITY: emphasis 5=urgent, 4=high, 2-3=medium {%- endcomment -%}
            {%- assign p = task.priority | default: 0 | plus: 0 -%}
            {%- if p >= 4 -%}
              {%- assign emphasis_class = "item--emphasis-3" -%}
            {%- elsif p >= 2 -%}
              {%- assign emphasis_class = "item--emphasis-2" -%}
            {%- else -%}
              {%- assign emphasis_class = "" -%}
            {%- endif -%}

            {%- comment -%} DUE DATE: relative format {%- endcomment -%}
            {%- assign due_text = nil -%}
            {%- if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil -%}
              {%- assign now_s = "now" | date: "%s" | plus: trmnl.user.utc_offset | default: 0 | plus: 0 -%}
              {%- assign due_s = task.due_date | date: "%s" | plus: 0 -%}
              {%- assign day_diff = due_s | minus: now_s | divided_by: 86400 -%}
              {%- if day_diff == 0 -%}
                {%- assign due_text = "Today" -%}
              {%- elsif day_diff == 1 -%}
                {%- assign due_text = "Tomorrow" -%}
              {%- elsif day_diff < 0 -%}
                {%- assign overdue_days = day_diff | abs -%}
                {%- assign due_text = "overdue " | append: overdue_days | append: "d" -%}
              {%- endif -%}
            {%- endif -%}

            <div class="item {{ emphasis_class }}">
              <div class="meta"></div>
              <div class="content">
                {%- if task.done -%}
                  <span class="title title--small text--gray-50 1bit:text--black 1bit:text--regular text--wrap" style="text-decoration: line-through;">{{ task.title }}</span>
                {%- else -%}
                  <span class="title title--small text--wrap">{{ task.title }}</span>
                {%- endif -%}
                {%- assign show_meta = false -%}
                {% if due_text %}{%- assign show_meta = true -%}{% endif %}
                {% if task.assignees.size > 0 %}{%- assign show_meta = true -%}{% endif %}
                {%- assign pnum = task.priority | default: 0 | plus: 0 -%}
                {% if pnum > 0 %}{%- assign show_meta = true -%}{% endif %}
                {%- if show_meta %}
                  <div class="flex gap--small {% unless is_portrait %}hidden{% endunless %}">
                    {%- if due_text -%}
                      <span class="label label--gray text--small 1bit:text--black 1bit:text--regular">{{ icon_calendar }} {{ due_text }}</span>
                    {%- endif -%}
                    {%- if task.assignees.size > 0 -%}
                      <span class="label label--gray text--small 1bit:text--black 1bit:text--regular">{{ icon_person }} {{ task.assignees[0].name }}</span>
                    {%- endif -%}
                    {% if pnum > 0 %}
                      <span class="label label--gray text--small 1bit:text--black 1bit:text--regular">{{ icon_flag }} {{ task.priority }}</span>
                    {% endif %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">No tasks</span>
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}

{{ title_bar }}

