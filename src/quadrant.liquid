<div class="layout layout--col">
  {% if data.size > 0 %}
    <div class="columns">
      <div class="column">
        {% for task in data %}
          <div class="item">
            <div class="meta"></div>
            <div class="content">
              <span class="title title--small">{{ task.title }}</span>
              {% if task.due_date != "0001-01-01T00:00:00Z" %}
                <span class="description">{{ task.due_date | date: "%b %d" }}</span>
              {% endif %}
              {% if task.percent_done > 0 %}
                <span class="label label--small label--gray">{{ task.percent_done | times: 100 | round: 0 }}%</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="title">No tasks found</span>
        <span class="description">Check your Vikunja connection</span>
      </div>
    </div>
  {% endif %}
</div>

{{ title_bar }}
