{%- comment -%}
  FULL VIEW (800x480 landscape, 480x800 portrait)
  ════════════════════════════════════════════════════════════════
  Shows 6-8 tasks in a 2-column grid layout when Task View is selected.
  When `view_mode` is set to "kanban", this template renders the Kanban board
  using the shared layout utilities. Kanban columns run horizontally in a
  landscape frame and stack vertically in a portrait frame, detected at runtime
  via trmnl.device.{width,height} (portrait when height > width).
{%- endcomment -%}

{%- assign view_name = "full" -%}
{%- assign device_height = trmnl.device.height | default: 480 | plus: 0 -%}
{%- assign device_width = trmnl.device.width | default: 800 | plus: 0 -%}
{%- if device_height > device_width -%}
  {%- assign is_portrait = true -%}
{%- else -%}
  {%- assign is_portrait = false -%}
{%- endif -%}
{%- if is_portrait -%}
  {%- comment -%} Portrait Full uses a standard side-by-side Kanban (vertical columns, vertical dividers), matching Half Horizontal and Landscape Full. {%- endcomment -%}
  {%- assign kanban_container_class = "flex flex--row flex--top h--full w--full gap" -%}
  {%- assign kanban_column_class = "stretch-x flex flex--col flex--left px--small" -%}
  {%- assign kanban_header_class = "title title--small lg:title--base text--center w--full" -%}
  {%- assign kanban_divider_class = "divider--v stretch-y" -%}
  {%- assign kanban_header_divider_class = "divider--h" -%}
  {%- assign kanban_title_class = "title title--small text--wrap" -%}
  {%- assign kanban_title_clamp = "" -%}
{%- else -%}
  {%- assign kanban_container_class = "flex flex--row flex--top h--full w--full gap" -%}
  {%- assign kanban_column_class = "stretch-x flex flex--col flex--left px--small" -%}
  {%- assign kanban_header_class = "title title--small lg:title--base text--center w--full" -%}
  {%- assign kanban_divider_class = "divider--v stretch-y" -%}
  {%- assign kanban_header_divider_class = "divider--h" -%}
  {%- assign kanban_title_class = "title title--small text--wrap" -%}
  {%- assign kanban_title_clamp = "" -%}
{%- endif -%}

{% if view_mode == "kanban" %}
  {% if kanban_error != "" %}
    <div class="layout layout--col flex--top gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">Kanban unavailable</span>
          <span class="description">{{ kanban_error }}</span>
        </div>
      </div>
    </div>
  {% elsif data.buckets and data.buckets.size > 0 %}
    <div class="layout layout--col layout--top gap">
      <div class="{{ kanban_container_class }}">
        {% for column in data.buckets %}
          <div class="{{ kanban_column_class }}">
            <span class="{{ kanban_header_class }}">{{ column.title | upcase }} ({{ column.tasks.size }})</span>
            {% if kanban_header_divider_class != "" %}<div class="{{ kanban_header_divider_class }}"></div>{% endif %}
            <div class="flex flex--col gap--small mt--small">
              {% for task in column.tasks %}
                {%- comment -%} PRIORITY: emphasis 4=urgent, 3=high, 2=medium {%- endcomment -%}
                {%- if task.priority == 4 -%}
                  {%- assign emphasis_class = "item--emphasis-3" -%}
                {%- elsif task.priority == 3 -%}
                  {%- assign emphasis_class = "item--emphasis-2" -%}
                {%- elsif task.priority == 2 -%}
                  {%- assign emphasis_class = "item--emphasis-1" -%}
                {%- else -%}
                  {%- assign emphasis_class = "" -%}
                {%- endif -%}
                <div class="item {{ emphasis_class }}">
                  <div class="meta"></div>
                  <div class="content">
                    {% if column.done or task.done %}
                      <span class="{{ kanban_title_class }} text--gray-50 1bit:text--black 1bit:text--regular" style="text-decoration: line-through;"{{ kanban_title_clamp }}>{{ task.title }}</span>
                    {% else %}
                      <span class="{{ kanban_title_class }}"{{ kanban_title_clamp }}>{{ task.title }}</span>
                    {% endif %}
                    {%- assign show_meta = false -%}
                    {% if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil %}{%- assign show_meta = true -%}{% endif %}
                    {% if task.assignees.size > 0 %}{%- assign show_meta = true -%}{% endif %}
                    {%- assign pnum = task.priority | default: 0 | plus: 0 -%}
                    {% if pnum > 0 %}{%- assign show_meta = true -%}{% endif %}
                    {% if column.done == false and show_meta %}
                      <div class="flex gap--small">
                        {% if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil %}
                          <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_calendar }} {{ task.due_date | l_date: "%d %b", trmnl.user.locale }}</span>
                        {% endif %}
                        {% if task.assignees.size > 0 %}
                          <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_person }} {{ task.assignees[0].name }}</span>
                        {% endif %}
                        {% if pnum > 0 %}
                          <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_flag }} {{ task.priority }}</span>
                        {% endif %}
                      </div>
                      {% endif %}
                    </div>
                </div>
              {% endfor %}
            </div>
          </div>
          {% unless forloop.last %}<div class="{{ kanban_divider_class }}"></div>{% endunless %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="title">No Kanban tasks</span>
      </div>
    </div>
  {% endif %}
{% else %}
  {%- comment -%}Task View rendering (2-column grid) {%- endcomment -%}
  {%- assign filtered_tasks = data -%}
  {%- assign tpv = tasks_per_view | plus: 0 -%}
  {%- if tpv < 1 -%}{%- assign tpv = 8 -%}{%- endif -%}
  {%- assign filtered_tasks = filtered_tasks | slice: 0, tpv -%}
  {%- assign half = filtered_tasks.size | plus: 1 | divided_by: 2 -%}
  {%- if half < 1 -%}{%- assign half = 1 -%}{%- endif -%}

  <div class="layout layout--col gap">
    {% if filtered_tasks.size > 0 %}
      <div class="columns" data-overflow-cols="2">
        <div class="column">
          {% for task in filtered_tasks limit: half %}
            {%- comment -%} PRIORITY: emphasis 5=urgent, 4=high, 2-3=medium {%- endcomment -%}
            {%- assign p = task.priority | default: 0 | plus: 0 -%}
            {%- if p >= 4 -%}
              {%- assign emphasis_class = "item--emphasis-3" -%}
            {%- elsif p >= 2 -%}
              {%- assign emphasis_class = "item--emphasis-2" -%}
            {%- else -%}
              {%- assign emphasis_class = "" -%}
            {%- endif -%}

            {%- comment -%} DUE DATE: relative format {%- endcomment -%}
            {%- assign due_text = nil -%}
            {%- if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil -%}
              {%- assign now_s = "now" | date: "%s" | plus: trmnl.user.utc_offset | default: 0 | plus: 0 -%}
              {%- assign due_s = task.due_date | date: "%s" | plus: 0 -%}
              {%- assign day_diff = due_s | minus: now_s | divided_by: 86400 -%}
              {%- if day_diff == 0 -%}
                {%- assign due_text = "Today" -%}
              {%- elsif day_diff == 1 -%}
                {%- assign due_text = "Tomorrow" -%}
              {%- elsif day_diff < 0 -%}
                {%- assign overdue_days = day_diff | abs -%}
                {%- assign due_text = "overdue by " | append: overdue_days | append: "d" -%}
              {%- else -%}
                {%- assign due_text = task.due_date | l_date: "%d/%m", trmnl.user.locale -%}
              {%- endif -%}
            {%- endif -%}

            <div class="item {{ emphasis_class }}">
              <div class="meta"></div>
              <div class="content">
                {%- if task.done -%}
                  <span class="title title--small lg:title--base text--wrap text--gray-50 1bit:text--black 1bit:text--regular" style="text-decoration: line-through;">{{ task.title }}</span>
                {%- else -%}
                  <span class="title title--small lg:title--base text--wrap">{{ task.title }}</span>
                {%- endif -%}
                {%- assign show_meta = false -%}
                {% if due_text %}{%- assign show_meta = true -%}{% endif %}
                {% if task.assignees.size > 0 %}{%- assign show_meta = true -%}{% endif %}
                {%- assign pnum = task.priority | default: 0 | plus: 0 -%}
                {% if pnum > 0 %}{%- assign show_meta = true -%}{% endif %}
                {%- if show_meta -%}
                  <div class="flex gap--small">
                    {%- if due_text -%}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_calendar }} {{ due_text }}</span>
                    {%- endif -%}
                    {%- if task.assignees.size > 0 -%}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_person }} {{ task.assignees[0].name }}</span>
                    {%- endif -%}
                    {% if pnum > 0 %}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_flag }} {{ task.priority }}</span>
                    {% endif %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {% endfor %}
        </div>
        <div class="column">
          {% for task in filtered_tasks offset: half %}
            {%- comment -%} PRIORITY: emphasis 5=urgent, 4=high, 2-3=medium {%- endcomment -%}
            {%- assign p = task.priority | default: 0 | plus: 0 -%}
            {%- if p >= 4 -%}
              {%- assign emphasis_class = "item--emphasis-3" -%}
            {%- elsif p >= 2 -%}
              {%- assign emphasis_class = "item--emphasis-2" -%}
            {%- else -%}
              {%- assign emphasis_class = "" -%}
            {%- endif -%}

            {%- comment -%} DUE DATE: relative format {%- endcomment -%}
            {%- assign due_text = nil -%}
            {%- if task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil -%}
              {%- assign now_s = "now" | date: "%s" | plus: trmnl.user.utc_offset | default: 0 | plus: 0 -%}
              {%- assign due_s = task.due_date | date: "%s" | plus: 0 -%}
              {%- assign day_diff = due_s | minus: now_s | divided_by: 86400 -%}
              {%- if day_diff == 0 -%}
                {%- assign due_text = "Today" -%}
              {%- elsif day_diff == 1 -%}
                {%- assign due_text = "Tomorrow" -%}
              {%- elsif day_diff < 0 -%}
                {%- assign overdue_days = day_diff | abs -%}
                {%- assign due_text = "overdue by " | append: overdue_days | append: "d" -%}
              {%- else -%}
                {%- assign due_text = task.due_date | l_date: "%d/%m", trmnl.user.locale -%}
              {%- endif -%}
            {%- endif -%}

            <div class="item {{ emphasis_class }}">
              <div class="meta"></div>
              <div class="content">
                {%- if task.done -%}
                  <span class="title title--small lg:title--base text--wrap text--gray-50 1bit:text--black 1bit:text--regular" style="text-decoration: line-through;">{{ task.title }}</span>
                {%- else -%}
                  <span class="title title--small lg:title--base text--wrap">{{ task.title }}</span>
                {%- endif -%}
                {%- assign show_meta = false -%}
                {% if due_text %}{%- assign show_meta = true -%}{% endif %}
                {% if task.assignees.size > 0 %}{%- assign show_meta = true -%}{% endif %}
                {%- assign pnum = task.priority | default: 0 | plus: 0 -%}
                {% if pnum > 0 %}{%- assign show_meta = true -%}{% endif %}
                {%- if show_meta -%}
                  <div class="flex gap--small">
                    {%- if due_text -%}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_calendar }} {{ due_text }}</span>
                    {%- endif -%}
                    {%- if task.assignees.size > 0 -%}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_person }} {{ task.assignees[0].name }}</span>
                    {%- endif -%}
                    {% if pnum > 0 %}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ icon_flag }} {{ task.priority }}</span>
                    {% endif %}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">No tasks found</span>
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}

{{ title_bar }}
