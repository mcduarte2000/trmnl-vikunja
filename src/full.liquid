{%- comment -%}
  FULL VIEW (800x480 landscape, 480x800 portrait)
  ════════════════════════════════════════════════════════════════
  Shows 6-8 tasks in a 2-column grid layout when Task View is selected.
  When `view_mode` is set to "kanban", this template renders the Kanban board
  using the shared layout utilities. Kanban columns run horizontally in a
  landscape frame and stack vertically in a portrait frame, detected at runtime
  via trmnl.device.{width,height} (portrait when height > width).
{%- endcomment -%}

{%- assign view_name = "full" -%}
{%- assign device_height = trmnl.device.height | default: 480 | plus: 0 -%}
{%- assign device_width = trmnl.device.width | default: 800 | plus: 0 -%}
{%- if device_height > device_width -%}
  {%- assign is_portrait = true -%}
{%- else -%}
  {%- assign is_portrait = false -%}
{%- endif -%}
{%- if is_portrait -%}
  {%- assign kanban_container_class = "flex flex--col flex--left gap" -%}
  {%- assign kanban_column_class = "flex flex--col flex--left px--small" -%}
  {%- assign kanban_header_class = "title title--small text--left" -%}
  {%- assign kanban_divider_class = "divider--h" -%}
{%- else -%}
  {%- assign kanban_container_class = "flex flex--row flex--top gap" -%}
  {%- assign kanban_column_class = "grow flex flex--col flex--left px--small" -%}
  {%- assign kanban_header_class = "title title--small lg:title--base text--left" -%}
  {%- assign kanban_divider_class = "divider--v" -%}
{%- endif -%}

{% if view_mode == "kanban" %}
  {% if kanban_error != "" %}
    <div class="layout layout--col flex--top gap">
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">Kanban unavailable</span>
          <span class="description">{{ kanban_error }}</span>
        </div>
      </div>
    </div>
  {% elsif data.buckets and data.buckets.size > 0 %}
    <div class="layout layout--col layout--top gap">
      <div class="{{ kanban_container_class }}">
        {% for column in data.buckets %}
          <div class="{{ kanban_column_class }}">
            <span class="{{ kanban_header_class }}">{{ column.title | upcase }} ({{ column.tasks.size }})</span>
            <div class="flex flex--col gap--small mt--small">
              {% for task in column.tasks %}
                {%- comment -%} PRIORITY: emphasis 4=urgent, 3=high, 2=medium {%- endcomment -%}
                {%- if task.priority == 4 -%}
                  {%- assign emphasis_class = "item--emphasis-3" -%}
                {%- elsif task.priority == 3 -%}
                  {%- assign emphasis_class = "item--emphasis-2" -%}
                {%- elsif task.priority == 2 -%}
                  {%- assign emphasis_class = "item--emphasis-1" -%}
                {%- else -%}
                  {%- assign emphasis_class = "" -%}
                {%- endif -%}
                <div class="item {{ emphasis_class }}">
                  <div class="meta"></div>
                  <div class="content">
                    {% if column.done or task.done %}
                      <span class="title title--small text--gray-50 1bit:text--black 1bit:text--regular" style="text-decoration: line-through;" data-clamp="1">{{ task.title }}</span>
                    {% else %}
                      <span class="title title--small" data-clamp="1">{{ task.title }}</span>
                    {% endif %}
                    {% if column.done == false and task.due_date != "0001-01-01T00:00:00Z" and task.due_date != nil %}
                      <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">due {{ task.due_date | date: "%d %b" }}</span>
                    {% endif %}
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
          {% unless forloop.last %}<div class="{{ kanban_divider_class }}"></div>{% endunless %}
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="title">No Kanban tasks</span>
      </div>
    </div>
  {% endif %}
{% else %}
  {%- comment -%}Task View rendering (2-column grid) {%- endcomment -%}
  {%- assign filtered_tasks = data -%}
  {%- assign tpv = tasks_per_view | plus: 0 -%}
  {%- if tpv < 1 -%}{%- assign tpv = 8 -%}{%- endif -%}
  {%- assign filtered_tasks = filtered_tasks | slice: 0, tpv -%}

  <div class="layout layout--col gap">
    {% if filtered_tasks.size > 0 %}
      <div class="grid grid--cols-2">
        {% for task in filtered_tasks %}
          {%- comment -%} PRIORITY: emphasis 4=urgent, 3=high, 2=medium {%- endcomment -%}
          {%- if task.priority == 4 -%}
            {%- assign emphasis_class = "item--emphasis-3" -%}
          {%- elsif task.priority == 3 -%}
            {%- assign emphasis_class = "item--emphasis-2" -%}
          {%- elsif task.priority == 2 -%}
            {%- assign emphasis_class = "item--emphasis-1" -%}
          {%- else -%}
            {%- assign emphasis_class = "" -%}
          {%- endif -%}
          <div class="item {{ emphasis_class }}">
            <div class="meta">
              <span class="index">{{ forloop.index }}</span>
            </div>
            <div class="content">
              <span class="title title--small lg:title--base" data-clamp="1">{{ task.title }}</span>
              {% if task.description != "" and task.description != nil %}
                <span class="description" data-clamp="1">{{ task.description | strip_html | truncate: 40 }}</span>
              {% endif %}
              {% if task.assignees.size > 0 %}
                <span class="description">{{ task.assignees[0].name }}</span>
              {% endif %}
              {% if task.due_date != "0001-01-01T00:00:00Z" %}
                <span class="label label--small label--gray 1bit:text--black 1bit:text--regular">{{ task.due_date | date: "%b %d" }}</span>
              {% endif %}
              {% if task.percent_done > 0 %}
                <span class="label label--small">{{ task.percent_done | times: 100 | round: 0 }}%</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="title">No tasks found</span>
          <span class="description">Check your filter settings</span>
        </div>
      </div>
    {% endif %}
  </div>
{% endif %}

{{ title_bar }}
