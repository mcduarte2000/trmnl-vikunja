<div class="layout layout--col gap">
  {% if filtered_tasks.size > 0 %}
    <div class="columns" data-overflow-max-cols="2">
      <div class="column">
        {% for task in filtered_tasks limit: 4 %}
          <div class="item">
            <div class="meta">
              <span class="index">{{ forloop.index }}</span>
            </div>
            <div class="content">
              <span class="title title--small" data-clamp="1">{{ task.title }}</span>
              {% if task.percent_done > 0 %}
                <span class="label label--small">{{ task.percent_done | times: 100 | round: 0 }}%</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="title">No tasks found</span>
      </div>
    </div>
  {% endif %}
</div>

{{ title_bar }}
